# SJT Tours & Travels - Environment Configuration Reference
# IMPORTANT: Never commit actual passwords or private keys to Git.
# Set these variables in the Render Dashboard (Environment tab).

PORT=5000
NODE_ENV=production
# Copy the current external connection URL from Voroa's Connect tab (including its port and sslmode=require).
DATABASE_URL=postgresql://<db_user>:<db_password>@db-0fd0c69bf9fd.db.getvoroa.com:27061/sjt_travels?sslmode=require
# Generate a stable random secret and set it in Render; never commit the value.
SJT_SESSION_SECRET=<set-a-random-stable-48-byte-hex-secret-in-render>
# Required only for the first production boot when the database has no ADMIN user.
# Remove the password from the Render environment after the admin signs in once.
SJT_BOOTSTRAP_ADMIN_EMAIL=<first-admin-email>
SJT_BOOTSTRAP_ADMIN_PASSWORD=<random-12-plus-character-password>
SJT_BOOTSTRAP_ADMIN_NAME=SJT Administrator
SJT_BOOTSTRAP_ADMIN_PHONE=<admin-phone>
SJT_S3_ENDPOINT=https://<account-or-bucket-endpoint>
SJT_S3_BUCKET=<private-bucket-name>
SJT_S3_REGION=<provider-region-or-auto>
SJT_S3_ACCESS_KEY_ID=<set-in-render>
SJT_S3_SECRET_ACCESS_KEY=<set-in-render>
SJT_S3_FORCE_PATH_STYLE=true
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
CORS_ORIGIN=https://sjttravels.com,https://admin.sjttravels.com
# Restrict this Google Maps Platform key to the Routes API and keep it only in Render.
GOOGLE_MAPS_API_KEY=<server-side-google-routes-api-key>
# Optional fixed airport transfer fee in rupees (default 100).
SJT_AIRPORT_FEE=100
SJT_LOCAL_SEDAN_BASE_FARE=100
SJT_LOCAL_SEDAN_INCLUDED_KM=4
SJT_LOCAL_SEDAN_PER_KM=24
SJT_LOCAL_MPV_BASE_FARE=115
SJT_LOCAL_MPV_INCLUDED_KM=4
SJT_LOCAL_MPV_PER_KM=28
SJT_LOCAL_INNOVA_BASE_FARE=130
SJT_LOCAL_INNOVA_INCLUDED_KM=4
SJT_LOCAL_INNOVA_PER_KM=32
